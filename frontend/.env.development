# Variables de build pour le DÉVELOPPEMENT (mode Vite "development").
# La CSP du script-src autorise 'unsafe-inline' uniquement ici : le plugin
# React de Vite injecte un script inline (preamble) en dev. En production
# (.env.production), script-src = 'self' strict.
# NB : les valeurs sont entre guillemets doubles pour CONSERVER les quotes
# simples internes (sinon dotenv les retire et la CSP devient invalide).
VITE_CSP_SCRIPT_SRC="'self' 'unsafe-inline'"
VITE_CSP_CONNECT_SRC="'self' https://*.supabase.co wss://*.supabase.co https://*.onrender.com http://localhost:* ws://localhost:*"
