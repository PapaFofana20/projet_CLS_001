# Variables de build pour la PRODUCTION (mode Vite "production").
# CSP stricte : aucun script inline autorisé (aucun n'est nécessaire — le
# bundle est externe, le JSON-LD est un bloc de données non exécutable).
# NB : guillemets doubles pour CONSERVER les quotes simples internes.
VITE_CSP_SCRIPT_SRC="'self'"
VITE_CSP_CONNECT_SRC="'self' https://*.supabase.co wss://*.supabase.co https://*.onrender.com"
